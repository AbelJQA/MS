import keyboard

mode = "normal"
deck_name = None
total_games = None

first_time_login = True

def set_mode(new_mode):
    global mode, deck_name, total_games
    mode = new_mode

    if mode == 'normal_6t':
        deck_name = 'deck_6_vm'
        total_games = 20
        
    elif mode == 'conquest_3t':
        deck_name = 'deck_3_vm'
        total_games = 10
        
    elif mode == 'high_voltage':
        deck_name = 'deck_high_voltage'
        total_games = 15
    
    elif mode == 'test':
        deck_name = 'deck_6_vm'
        total_games = 1

