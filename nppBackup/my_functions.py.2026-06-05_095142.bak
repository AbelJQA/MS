# USO RARO PERO UTIL

def collect_battle_pass_rewards():
    
    resize_window_by_tuple(["SNAP"], region = globals.REGION_MS_WINDOW)
    
    '''
    Inicia en la pantalla main_stage
    '''
    logger.info("Intentando detectar y hacer clic en el botón del season pass")
    click_any_MS_img(r'images/stages/main_stage/season_pass.PNG', delay_click=.1)

    start = time.time()
    logger.info("Entrando al bucle principal por 4 segundos...")

    while time.time() - start < 4:
        logger.info("Buscando botón 'free'...")
        free = search_MS_img(r'images/stages/season_pass_stage/free.PNG')
        if free:
            logger.info("Encontrado botón 'free' en", free)
            click_pos(free, delay_click=.1)

            logger.info("Buscando imagen 'claim!' con tiempo mínimo 3s...")
            if search_MS_img(r'images/claim!.PNG', timeout=3):
                logger.info("'claim!' detectado")

                logger.info("Verificando si estamos en la pantalla de rewards con el botón 'set'")
                if search_MS_img(r'images/stages/collection_rewards_stage/set.png'):
                    logger.info("Botón 'set' detectado, esperando 5s...")
                    time.sleep(5)

                    logger.info("Haciendo clic en 'claim!'")
                    click_any_MS_img(r'images/claim!.PNG', delay_click=.1)
                    pg.move(-200, -300)

                    logger.info("Buscando botón 'nice!' con tiempo mínimo 4s...")
                    nice = search_MS_img(r'images/stages/collection_rewards_stage/nice!.PNG', timeout=4)
                    if nice:
                        logger.info("Botón 'nice!' detectado en", nice)
                        click_pos(nice)
                        pg.move(-200, -300)
                    else:
                        logger.info("No se detectó 'nice!'")
                else:
                    logger.info("No se detectó botón 'set', solo se hace clic en 'claim!'")
                    click_any_MS_img(r'images/claim!.PNG', delay_click=.1)
                    pg.move(-200, -300)

            else:
                logger.info("No se detectó 'claim!'")

            logger.info("Reseteando temporizador del bucle")
            start = time.time()
        else:
            logger.info("'free' no detectado en este ciclo")

        time.sleep(1)

    logger.info("Terminó el bucle, iniciando beep_forever()")
    beep_forever()


# CHECK APPDATA NPROV JSON


def obtener_postgame_xp(json_file=rf'C:\Users\{os.getlogin()}\AppData\LocalLow\Second Dinner\SNAP\Standalone\States\nvprod\BattlePassState.json'):
    try:
        with open(json_file, 'r', encoding='utf-8-sig') as file:
            data = json.load(file)
        return data['ServerState']['BattlePass']['PostGameXpTrackedAmount']
    except KeyError:
        logger.info("⚠️ No se encontró 'PostGameXpTrackedAmount' en el archivo, se omitió este valor.")
        return 0
    except Exception as e:
        logger.info(f"❌ Error al leer el archivo: {e}")
        return 0


def guardar_datos_en_txt():
    # Abrir el archivo JSON
    with open(rf'C:\Users\{globals.USER_NAME}\AppData\LocalLow\Second Dinner\SNAP\Standalone\States\nvprod\BattlePassState.json', 'r', encoding='utf-8-sig') as file:
        data = json.load(file)

    # Guardar el valor de la llave "PostGameXpTrackedAmount"
    postgame_xp_tracked_amount = data['ServerState']['BattlePass']['PostGameXpTrackedAmount']

    # Iterar sobre los valores de MSs
    for snap_path in globals.MSs:
        # Guardar los valores en el archivo de texto para cada snap_path
        with open(rf'C:\Users\{globals.USER_NAME}\Desktop\aea.txt', 'a') as file:  # Usamos 'a' para agregar datos al archivo
            file.write(f"{snap_path}: {postgame_xp_tracked_amount}\n")

    logger.info("Datos guardados")


